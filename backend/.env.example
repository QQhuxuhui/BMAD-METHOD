# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
LLM_API_KEY="your-llm-api-key" # e.g. OpenAI API key
LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=2000
MAX_LLM_CALL_RETRIES=3

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# ===================================
# Model Adapter Configuration
# ===================================

# Encryption Key for API Keys (MUST change in production)
ENCRYPTION_KEY="your-encryption-key-change-in-production"

# Default Model Configuration
DEFAULT_MODEL_PROVIDER=qwen
DEFAULT_MODEL_NAME=default-model

# Model Health Check Configuration
MODEL_HEALTH_CHECK_INTERVAL=300  # seconds (5 minutes)
MODEL_HEALTH_CHECK_TIMEOUT=10.0  # seconds
MODEL_MAX_CONSECUTIVE_FAILURES=3

# Model Request Configuration
MODEL_DEFAULT_TIMEOUT=30.0  # seconds
MODEL_DEFAULT_MAX_RETRIES=3
MODEL_RETRY_DELAY=1.0  # seconds

# ===================================
# Qwen Model Configuration (通义千问 - 私有化部署)
# ===================================
QWEN_API_KEY="your-qwen-api-key"  # 私有化部署可以为空或任意值
QWEN_API_BASE_URL="http://10.90.15.22:8103/v1"
QWEN_MODEL_VERSION="qwen3-30b-a3b"
QWEN_MAX_TOKENS=4096
QWEN_TEMPERATURE=0.7

# ===================================
# DeepSeek Model Configuration (深度求索 - 私有化部署)
# ===================================
DEEPSEEK_API_KEY="your-deepseek-api-key"  # 私有化部署可以为空或任意值
DEEPSEEK_API_BASE_URL="http://10.90.15.22:8103/v1"
DEEPSEEK_MODEL_VERSION="deepseek-r1"
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.7

# ===================================
# GLM Model Configuration (智谱AI - 可选)
# ===================================
GLM_API_KEY="your-glm-api-key"
GLM_API_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
GLM_MODEL_VERSION="glm-4"
GLM_MAX_TOKENS=4096
GLM_TEMPERATURE=0.7
