# ===================================
# BMAD LangGraph 1.0 环境配置模板
# ===================================
# 使用说明：
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 根据实际环境修改以下配置值
# 3. .env 文件已在 .gitignore 中，不会被提交到版本控制

# -----------------------------------
# 数据库配置 (PostgreSQL)
# -----------------------------------
# 数据库名称
POSTGRES_DB=bmad_langgraph_dev

# 数据库用户名
POSTGRES_USER=bmad_user

# 数据库密码（请修改为安全密码）
POSTGRES_PASSWORD=bmad_dev_password_change_me

# 数据库连接字符串（用于应用程序连接）
# 格式：postgresql://[用户名]:[密码]@[主机]:[端口]/[数据库名]
DATABASE_URL=postgresql://bmad_user:bmad_dev_password_change_me@localhost:5432/bmad_langgraph_dev

# -----------------------------------
# Redis配置（会话缓存和任务队列）
# -----------------------------------
# Redis连接字符串
# 格式：redis://[主机]:[端口]/[数据库编号]
REDIS_URL=redis://localhost:6379/0

# -----------------------------------
# LLM API密钥配置
# -----------------------------------
# Phase 1 阶段暂时可为空
# 后续Story中将配置实际的API密钥

# OpenAI API密钥
OPENAI_API_KEY=

# 阿里云通义千问API密钥
QWEN_API_KEY=

# 智谱AI GLM API密钥
GLM_API_KEY=

# DeepSeek API密钥
DEEPSEEK_API_KEY=

# -----------------------------------
# 应用程序配置（可选）
# -----------------------------------
# API服务端口
# API_PORT=8000

# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# 环境标识 (development, staging, production)
# ENVIRONMENT=development
